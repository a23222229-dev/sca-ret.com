---
import Layout from '../../layouts/Layout.astro';

// 逐字取自 scaretimportplan-draft.md 第 4.2 節，法律條款禁止改寫措辭。
const clauses = [
  { title: '服務啟動與提供方式', body: '付款後立即啟動法律團隊服務，後續服務均會提供合法合規法律意見，但仍需您自行決定。主要透過 LINE 官方帳號提供服務，係因對話記錄具備憑證效力，有助避免後續爭議。面對面諮詢需額外付費。' },
  { title: '服務內容與期限', body: '本服務提供退休安心三寶（安養信託、意定監護、自書遺囑）協定服務，服務期限為一年內完成選定方案之協定。專案客戶請記得填寫介紹碼，填寫正確後可享有一年份防詐法律顧問諮詢權益。' },
  { title: '服務範圍限制', body: '保險、理財相關問題請洽詢轉介之財務顧問。超出本服務範圍之事務，將轉介合作之專業第三方處理。客戶因接受轉介第三方服務所生之一切爭議，與本公司無涉，概由客戶自行負責。' },
  { title: '不退款政策', body: '本服務如同律師委任，付款後立即啟動法律服務，恕不退款。防詐法律顧問服務於購買時即生效，無論客戶是否實際使用，皆視為服務已開始提供。' },
  { title: '服務終止條件', body: '以下情況本公司得終止服務：客戶違反本條款規定；客戶提供不實資訊；客戶逾期未配合完成必要程序超過九十日；客戶有其他不當行為影響服務進行；法律或主管機關要求終止之情況。' },
  { title: '個人資料保護', body: '本公司蒐集之個人資料僅用於提供法律諮詢服務、合約協定、客戶聯繫及後續服務。資料使用範圍包括本公司法律團隊內部服務提供、轉介合作第三方時之必要資訊提供，以及相關政府機關申辦程序。本公司依個人資料保護法規定妥善保管，不作其他目的使用。服務完成後，本公司將保存客戶資料五年，期滿後依法銷毀。' },
  { title: '智慧財產權', body: '本公司提供之所有文件、表單、建議書、制式契約範本等均為本公司智慧財產，客戶僅得於本服務範圍內使用，不得複製、散布或作為其他用途。' },
  { title: '免責聲明', body: '本公司提供之法律意見僅供參考，最終決定權在客戶。本公司不保證特定結果，客戶應依自身狀況審慎評估後決定。客戶與法律團隊成員於本公司指定服務管道（LINE 官方帳號或 email）外進行之私人聯繫、協議或約定，本公司概不負責，亦不承擔任何法律責任。客戶因接受轉介第三方服務所生之一切爭議，與本公司無涉，概由客戶自行負責。' },
  { title: '損害賠償限制', body: '本公司對客戶之損害賠償責任，以客戶實際支付之服務費用為上限。本公司對任何間接損失、利潤損失、機會損失或精神損害概不負責。' },
  { title: '不可抗力', body: '因天災、戰爭、疫情、政府政策變更、法令修改等不可抗力因素，致無法履行本服務者，本公司不負違約責任且不退還已收取之費用。不可抗力期間，服務期限相應順延。不可抗力期間超過九十日者，任一方得終止本服務關係，但本公司仍不退還已收取之費用。' },
  { title: '爭議處理', body: '如因本服務發生爭議，雙方應先進行協商調解。協商不成時，同意以台灣台中地方法院為第一審管轄法院。' },
  { title: '其他約定', body: '點擊購買即表示同意本聲明所有條款。本條款如有未盡事宜，依中華民國相關法律規定辦理。本公司保留隨時修改本條款之權利，修改後條款將公告於官方網站，繼續使用服務視為同意修改後條款。' },
];
---
<Layout title="服務條款與重要聲明" description="SCA 服務條款與重要聲明">
  <section class="terms">
    <h1>服務條款與重要聲明</h1>
    <ol>
      {clauses.map((clause) => (
        <li><strong>{clause.title}</strong>：{clause.body}</li>
      ))}
    </ol>
  </section>
</Layout>

<style>
  .terms { max-width: 720px; margin: 0 auto; }
  .terms h1 { font-size: var(--text-2xl); margin-bottom: 2rem; text-align: center; }
  .terms ol { padding-left: 1.5rem; }
  .terms li {
    margin-bottom: 1.5rem;
    font-size: var(--text-sm);
    color: var(--ink-soft);
    line-height: var(--leading);
  }
  .terms li strong { color: var(--ink); }
</style>
