---
import Layout from '../../layouts/Layout.astro';
import { RETIREMENT_MODULES } from '../../lib/site.ts';
---
<Layout title="會員專區" description="SCA 會員專區登入">
  <section class="login">
    <form class="login__form login__card" onsubmit="return false">
      <label>
        Email
        <input type="email" placeholder="Email" disabled />
      </label>
      <label>
        Password
        <input type="password" placeholder="Password" disabled />
      </label>
      <div class="login__remember">
        <label>
          <input type="checkbox" disabled /> 記住賬號
        </label>
      </div>
      <button type="button" disabled>Sign In</button>
    </form>
    <p class="login__note">＊此頁為原站現況的靜態展示，尚未串接真實登入功能。</p>
  </section>

  <section class="badges">
    {RETIREMENT_MODULES.map((m) => (
      <div class="badge">
        <div class="badge__hex"><span>{m.name}</span></div>
      </div>
    ))}
  </section>
</Layout>

<style>
  .login { max-width: 420px; margin: 0 auto 4rem; text-align: center; }
  .login__card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 2rem;
    box-shadow: var(--shadow-lg);
  }
  .login__form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    text-align: left;
  }
  .login__form label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }
  .login__form input[type="email"],
  .login__form input[type="password"] {
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: var(--text-base);
    background: var(--paper);
  }
  .login__remember label {
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
  }
  .login__form button {
    background: var(--brand);
    color: var(--on-brand);
    border: none;
    border-radius: var(--radius-sm);
    padding: 0.75rem;
    font-size: var(--text-base);
    font-weight: 700;
    cursor: not-allowed;
  }
  .login__note {
    margin-top: 1rem;
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }

  .badges {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    justify-items: center;
  }
  .badge__hex {
    width: 220px;
    height: 200px;
    padding: 3px;
    background: var(--accent-brick-border);
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    display: flex;
    transition: transform var(--transition);
  }
  .badge__hex:hover {
    transform: translateY(-4px);
  }
  .badge__hex span {
    flex: 1;
    background: var(--accent-brick);
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    color: var(--on-brand);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-weight: 700;
    font-size: var(--text-base);
    padding: 0 1.5rem;
  }
</style>
