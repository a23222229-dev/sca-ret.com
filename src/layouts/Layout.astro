---
import '../styles/variables.css';
import { SITE_NAME, SITE_BRAND, NAV, COPYRIGHT, PARTNERS, CONTACT_EMAIL, LINE_OFFICIAL_ACCOUNT_NAME } from '../lib/site.ts';

const { title, description = SITE_NAME } = Astro.props;
const base = import.meta.env.BASE_URL;

function resolveHref(href) {
  if (href.startsWith('http')) return href;
  return base.endsWith('/') ? base + href.slice(1) : base + href;
}
---
<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | {SITE_BRAND}</title>
  <meta name="description" content={description} />
</head>
<body>
  <header class="site-header">
    <div class="site-header__inner">
      <a class="brand" href={resolveHref('/')}>
        Sca <span class="brand__r">R</span>et.
      </a>
      <nav class="nav">
        {NAV.map((item) => (
          <a href={resolveHref(item.href)}>{item.label}</a>
        ))}
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="site-footer__inner">
      <div class="site-footer__partners">
        {PARTNERS.map((p) => (
          p.url
            ? <a href={p.url} target="_blank" rel="noopener">{p.name}</a>
            : <span>{p.name}</span>
        ))}
      </div>
      <p class="site-footer__contact">
        {CONTACT_EMAIL} ・ LINE官方帳號：{LINE_OFFICIAL_ACCOUNT_NAME}
      </p>
      <p class="site-footer__copyright">{COPYRIGHT}</p>
    </div>
  </footer>
</body>
</html>

<style>
  :global(html) {
    font-family: var(--font-sans);
    background: var(--paper);
    color: var(--ink);
  }
  :global(body) {
    margin: 0;
    line-height: var(--leading);
  }
  :global(a) {
    color: var(--brand-deep);
  }
  :global(h1), :global(h2), :global(h3) {
    line-height: 1.3;
  }

  .site-header {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .site-header__inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .brand {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--brand);
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  .brand__r {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1em;
    height: 1em;
    border: 2px solid currentColor;
    border-radius: 50%;
    font-size: 0.7em;
    vertical-align: middle;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }
  .nav a {
    color: var(--ink);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .nav a:hover {
    color: var(--brand-deep);
  }

  main {
    max-width: var(--container);
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .site-footer {
    background: var(--footer-bg);
    color: var(--on-dark);
    margin-top: 3rem;
  }
  .site-footer__inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 2rem 1.5rem;
    text-align: center;
  }
  .site-footer__partners {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .site-footer__partners a,
  .site-footer__partners span {
    color: var(--on-dark);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .site-footer__contact {
    font-size: var(--text-sm);
    margin: 0.5rem 0;
  }
  .site-footer__copyright {
    font-size: var(--text-xs);
    opacity: 0.7;
    margin: 0.5rem 0 0;
  }
</style>
